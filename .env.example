# Copy this file to .env and fill in real values.
# Never commit .env or real credentials.

# MongoDB connection string.
MONGODB_URI=mongodb://127.0.0.1:27017/mentor_lagbe

# HTTP port for the Express API.
PORT=8000

# Base URL of the Better Auth client (Next.js app).
# Used to derive the JWKS endpoint (<BETTER_AUTH_URL>/api/auth/jwks)
# and as the expected JWT issuer and audience.
# In production, set this to the deployed client URL.
BETTER_AUTH_URL=http://localhost:3000
